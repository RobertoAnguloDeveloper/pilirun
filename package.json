{
  "name": "pilirun",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && next dev --hostname 0.0.0.0",
    "build": "node scripts/prepare-assets.mjs && next build && node scripts/finalize-assets.mjs",
    "start": "next start --hostname 0.0.0.0",
    "postinstall": "node scripts/prepare-assets.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests docs scripts/*.mjs *.ts *.json README.md",
    "format:check": "prettier --check src tests docs scripts/*.mjs *.ts *.json README.md",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.45.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
